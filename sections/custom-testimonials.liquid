{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 56 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
  }

  .wa-reviews {
    background: #FFFFFF;
    position: relative;
    border-top: 1px solid #EAE5DE;
    border-bottom: 1px solid #EAE5DE;
  }

  .wa-reviews__container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  .wa-reviews__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3rem auto;
  }

  /* Star Rating Aggregate Pill */
  .wa-reviews__rating-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1.1rem;
    background: #FAF6ED;
    border: 1px solid #E5D7B5;
    border-radius: 30px;
    margin-bottom: 1rem;
  }

  .wa-reviews__stars-row {
    color: #D4AF37;
    font-size: 0.95rem;
    letter-spacing: 0.1em;
  }

  .wa-reviews__rating-text {
    font-size: 0.82rem;
    font-weight: 700;
    color: #917333;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .wa-reviews__title {
    font-family: var(--wa-font-heading, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(2rem, 3.4vw, 2.85rem);
    font-weight: 700;
    color: #121212;
    margin: 0 0 0.75rem 0;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .wa-reviews__subtitle {
    font-family: var(--wa-font-body, 'Montserrat', sans-serif);
    font-size: 0.98rem;
    color: #555555;
    margin: 0;
    line-height: 1.7;
  }

  /* Cards Grid */
  .wa-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
    margin-bottom: 2.8rem;
  }

  @media screen and (max-width: 989px) {
    .wa-reviews__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.2rem;
    }
  }

  @media screen and (max-width: 640px) {
    .wa-reviews__grid {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }
  }

  .wa-review-card {
    background: #FAF8F5;
    border: 1.5px solid #EAE5DE;
    border-radius: 12px;
    padding: 1.8rem 1.6rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.2rem;
    transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.02);
  }

  .wa-review-card:hover {
    background: #FFFFFF;
    border-color: #B8974F;
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(184, 151, 79, 0.16);
  }

  .wa-review-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #EFEAE2;
    padding-bottom: 0.85rem;
  }

  .wa-review-card__stars {
    color: #D4AF37;
    font-size: 1rem;
    letter-spacing: 0.1em;
  }

  .wa-review-card__verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #2D6A4F;
    background: #E8F5E9;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    border: 1px solid #C8E6C9;
  }

  .wa-review-card__perfume-tag {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #917333;
    display: inline-block;
  }

  .wa-review-card__headline {
    font-family: var(--wa-font-heading, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: #121212;
    margin: 0.25rem 0 0.5rem 0;
    line-height: 1.35;
  }

  .wa-review-card__quote {
    font-size: 0.92rem;
    color: #4A4A4A;
    line-height: 1.7;
    margin: 0;
  }

  .wa-review-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #EFEAE2;
    padding-top: 0.85rem;
  }

  .wa-review-card__author {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .wa-review-card__author-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: #121212;
  }

  .wa-review-card__author-loc {
    font-size: 0.75rem;
    color: #888888;
  }

  .wa-review-card__metric-pill {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #917333;
    background: #FAF6ED;
    border: 1px solid #E5D7B5;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  /* Bottom Trust Strip */
  .wa-reviews__trust-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    padding: 1.2rem;
    background: #FAF8F5;
    border: 1px solid #EAE5DE;
    border-radius: 8px;
    text-align: center;
  }

  .wa-reviews__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #121212;
  }

  .wa-reviews__trust-item span {
    color: #B8974F;
    font-size: 0.95rem;
  }
{%- endstyle -%}

<div class="wa-reviews section-{{ section.id }}-padding">
  <div class="wa-reviews__container">
    
    <div class="wa-reviews__header">
      <div class="wa-reviews__rating-pill">
        <span class="wa-reviews__stars-row">★★★★★</span>
        <span class="wa-reviews__rating-text">4.9 / 5.0 • 2,800+ Verified Buyers</span>
      </div>

      <h2 class="wa-reviews__title">{{ section.settings.title | default: 'Loved by Fragrance Connoisseurs' }}</h2>
      
      <p class="wa-reviews__subtitle">
        {{ section.settings.subtitle | default: 'Read unfiltered feedback from perfume lovers across India who switched to pure, uncut Kannauj attars.' }}
      </p>
    </div>

    <!-- 3-Column Luxury Review Cards Grid -->
    <div class="wa-reviews__grid">
      {%- for block in section.blocks -%}
        <div class="wa-review-card" {{ block.shopify_attributes }}>
          <div>
            <div class="wa-review-card__top">
              <span class="wa-review-card__stars">★★★★★</span>
              <span class="wa-review-card__verified-badge">✓ Verified Buyer</span>
            </div>

            {%- if block.settings.perfume != blank -%}
              <span class="wa-review-card__perfume-tag">✦ {{ block.settings.perfume }}</span>
            {%- endif -%}

            {%- if block.settings.headline != blank -%}
              <h3 class="wa-review-card__headline">{{ block.settings.headline }}</h3>
            {%- endif -%}

            <p class="wa-review-card__quote">“{{ block.settings.quote }}”</p>
          </div>

          <div class="wa-review-card__footer">
            <div class="wa-review-card__author">
              <span class="wa-review-card__author-name">{{ block.settings.author }}</span>
              <span class="wa-review-card__author-loc">{{ block.settings.location }}</span>
            </div>
            
            {%- if block.settings.longevity_tag != blank -%}
              <span class="wa-review-card__metric-pill">{{ block.settings.longevity_tag }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <!-- Bottom Reassurance Strip -->
    <div class="wa-reviews__trust-bar">
      <div class="wa-reviews__trust-item">
        <span>✦</span> 100% Spill-Proof Roll-On Seal
      </div>
      <div class="wa-reviews__trust-item">
        <span>✦</span> Free Cash On Delivery Pan-India
      </div>
      <div class="wa-reviews__trust-item">
        <span>✦</span> 7-Day Hassle-Free Scent Guarantee
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Luxury Customer Reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Loved by Fragrance Connoisseurs"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Read unfiltered feedback from perfume lovers across India who switched to pure, uncut Kannauj attars."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Verified Review",
      "settings": [
        {
          "type": "text",
          "id": "perfume",
          "label": "Perfume Purchased",
          "default": "Turkish Oud Luxury Attar"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Review Headline",
          "default": "Lasts easily 16 hours. Pure compliments."
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Customer Quote",
          "default": "I have spent thousands on designer EDPs, but this pure Turkish Oud is on another level. Just 2 dabs on my collar and wrist lasted through an 11-hour office shift and dinner. Zero synthetic chemical smell."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer Name",
          "default": "Vikramaditya Sharma"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Customer City",
          "default": "New Delhi • Verified Order"
        },
        {
          "type": "text",
          "id": "longevity_tag",
          "label": "Metric Pill",
          "default": "16+ Hours Verified"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Customer Reviews",
      "blocks": [
        {
