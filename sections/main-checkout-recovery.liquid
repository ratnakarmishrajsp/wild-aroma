{% comment %}Operations shortcut only; no customer data or API credential is present on this page.{% endcomment %}
<meta name="robots" content="noindex, nofollow">
<style>
  .wa-recovery { min-height: 76vh; padding: 48px 20px 80px; background: #101319; color: #f6f3eb; font-family: system-ui, sans-serif; }
  .wa-recovery__inner { max-width: 1040px; margin: 0 auto; }
  .wa-recovery__eyebrow { color: #cba96b; font-size: 12px; font-weight: 750; letter-spacing: .18em; text-transform: uppercase; }
  .wa-recovery h1 { margin: 8px 0 12px; font-size: clamp(30px, 4vw, 48px); line-height: 1.1; }
  .wa-recovery h1, .wa-recovery h2 { color: #f6f3eb !important; }
  .wa-recovery p { color: #aeb5bf; line-height: 1.6; }
  .wa-recovery__card { margin-top: 28px; padding: clamp(22px, 4vw, 38px); border: 1px solid #3b3f43; border-radius: 18px; background: #191d25; }
  .wa-recovery__card h2 { margin: 0 0 8px; font-size: 24px; }
  .wa-recovery__link { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; margin-top: 14px; padding: 12px 20px; border: 1px solid #cba96b; border-radius: 9px; background: #cba96b; color: #19130a; font: inherit; font-weight: 750; text-decoration: none; }
  .wa-recovery__link:hover { filter: brightness(1.1); }
  .wa-recovery__note { margin-top: 22px; padding: 16px 18px; border-left: 3px solid #cba96b; background: #191d25; font-size: 13px; }
  .wa-recovery__steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; margin-top: 22px; }
  .wa-recovery__steps > div { padding: 18px; border: 1px solid #3b3f43; border-radius: 12px; background: #191d25; }
  .wa-recovery__steps strong { color: #f6f3eb; }
  .wa-recovery__steps p { margin: 7px 0 0; font-size: 13px; }
</style>

<section class="wa-recovery">
  <div class="wa-recovery__inner">
    <span class="wa-recovery__eyebrow">Wild Aroma · Store operations</span>
    <h1>Abandoned Checkout</h1>
    <p>Shopify के live abandoned checkouts देखने और recovery करने का रास्ता।</p>

    <div class="wa-recovery__card">
      <h2>Shopify में देखें</h2>
      <p>Shopify Admin में <strong>Orders → Abandoned checkouts</strong> खोलें। वहाँ खुली checkout सूची और recovery विकल्प मिलेंगे।</p>
      <a class="wa-recovery__link" href="https://admin.shopify.com/store/gnbs7t-q1/orders" target="_blank" rel="noopener noreferrer">Shopify Orders खोलें ↗</a>
    </div>

    <p class="wa-recovery__note">मैनुअल COD/PayU फॉर्म छोड़ने वाले ग्राहक Shopify abandoned checkout सूची में नहीं आते। ग्राहक से अलग recovery सहमति लिए बिना उनका नंबर रिकॉर्ड नहीं किया जा रहा है।</p>

    <div class="wa-recovery__steps">
      <div><strong>1. Checkout देखें</strong><p>Shopify में Orders → Abandoned checkouts चुनें और संबंधित checkout खोलें।</p></div>
      <div><strong>2. Order जाँचें</strong><p>रिकवरी से पहले पुष्टि करें कि ग्राहक का order पहले पूरा नहीं हो चुका है।</p></div>
      <div><strong>3. Recovery करें</strong><p>उपलब्ध Shopify recovery email विकल्प इस्तेमाल करें। व्यक्तिगत संपर्क तभी करें जब अनुमति हो।</p></div>
    </div>
  </div>
</section>

{% schema %}
{"name":"Checkout Recovery","tag":"section","class":"section-checkout-recovery","settings":[]}
{% endschema %}
