{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 56 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
  }

  .wa-anatomy {
    background: #FAF8F5;
    border-top: 1px solid #EAE5DE;
    border-bottom: 1px solid #EAE5DE;
    position: relative;
    overflow: hidden;
  }

  .wa-anatomy__container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  .wa-anatomy__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3rem auto;
  }

  .wa-anatomy__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #917333;
    background: #FFFFFF;
    border: 1px solid #E5D7B5;
    padding: 0.35rem 0.95rem;
    border-radius: 4px;
    margin-bottom: 0.85rem;
    box-shadow: 0 2px 10px rgba(184, 151, 79, 0.1);
  }

  .wa-anatomy__title {
    font-family: var(--wa-font-heading, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(2rem, 3.4vw, 2.85rem);
    font-weight: 700;
    color: #121212;
    margin: 0 0 0.75rem 0;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .wa-anatomy__subtitle {
    font-family: var(--wa-font-body, 'Montserrat', sans-serif);
    font-size: 0.98rem;
    color: #555555;
    margin: 0;
    line-height: 1.7;
  }

  /* Attar Switcher Tabs */
  .wa-anatomy__tabs {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .wa-anatomy__tab-btn {
    padding: 0.7rem 1.4rem;
    background: #FFFFFF;
    border: 1.5px solid #EAE5DE;
    border-radius: 30px;
    font-family: var(--wa-font-body, 'Montserrat', sans-serif);
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4A4A4A;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
  }

  .wa-anatomy__tab-btn:hover {
    border-color: #B8974F;
    color: #121212;
  }

  .wa-anatomy__tab-btn.is-active {
    background: #121212;
    color: #FFFFFF;
    border-color: #121212;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
  }

  /* Grid Layout: Left Stats Panel + Right Phase Timeline */
  .wa-anatomy__layout {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 2.5rem;
    align-items: stretch;
  }

  @media screen and (max-width: 989px) {
    .wa-anatomy__layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Left Panel: Scent Profile Card */
  .wa-anatomy__profile-card {
    background: #FFFFFF;
    border: 1.5px solid #EAE5DE;
    border-radius: 12px;
    padding: 2.2rem 1.8rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .wa-anatomy__profile-tag {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #917333;
    display: block;
    margin-bottom: 0.35rem;
  }

  .wa-anatomy__profile-name {
    font-family: var(--wa-font-heading, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.85rem;
    font-weight: 700;
    color: #121212;
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
  }

  .wa-anatomy__profile-vibe {
    font-size: 0.88rem;
    color: #555555;
    line-height: 1.6;
    margin: 0;
  }

  /* Metrics Gauges */
  .wa-anatomy__metrics {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    border-top: 1px solid #EFEAE2;
    border-bottom: 1px solid #EFEAE2;
    padding: 1.4rem 0;
  }

  .wa-anatomy__metric {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .wa-anatomy__metric-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .wa-anatomy__metric-label {
    color: #666666;
  }

  .wa-anatomy__metric-val {
    color: #B8974F;
  }

  .wa-anatomy__metric-bar {
    width: 100%;
    height: 6px;
    background: #EFEAE2;
    border-radius: 3px;
    overflow: hidden;
  }

  .wa-anatomy__metric-fill {
    height: 100%;
    background: linear-gradient(90deg, #CCA43B 0%, #B8974F 100%);
    border-radius: 3px;
    transition: width 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .wa-anatomy__profile-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.95rem 1.5rem;
    background: #121212;
    color: #FFFFFF;
    font-size: 0.86rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.3s ease;
  }

  .wa-anatomy__profile-cta:hover {
    background: #B8974F;
    color: #121212;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(184, 151, 79, 0.3);
  }

  /* Right Panel: 3 Evolution Phases */
  .wa-anatomy__phases {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .wa-anatomy__phase-card {
    background: #FFFFFF;
    border: 1.5px solid #EAE5DE;
    border-radius: 12px;
    padding: 1.6rem 1.8rem;
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1.5rem;
    align-items: center;
    transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: relative;
    overflow: hidden;
  }

  @media screen and (max-width: 600px) {
    .wa-anatomy__phase-card {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      padding: 1.3rem 1.2rem;
    }
  }

  .wa-anatomy__phase-card:hover {
    border-color: #B8974F;
    box-shadow: 0 8px 25px rgba(184, 151, 79, 0.15);
    transform: translateX(4px);
  }

  .wa-anatomy__phase-badge-col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .wa-anatomy__phase-num {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #917333;
  }

  .wa-anatomy__phase-title {
    font-family: var(--wa-font-heading, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: #121212;
    margin: 0;
    line-height: 1.2;
  }

  .wa-anatomy__phase-time {
    font-size: 0.76rem;
    font-weight: 600;
    color: #888888;
    display: inline-block;
  }

  .wa-anatomy__phase-desc-col {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .wa-anatomy__phase-notes {
    font-size: 0.98rem;
    font-weight: 700;
    color: #1A1A1A;
    line-height: 1.5;
    margin: 0;
  }

  .wa-anatomy__phase-story {
    font-size: 0.86rem;
    color: #666666;
    line-height: 1.6;
    margin: 0;
  }
{%- endstyle -%}

<div class="wa-anatomy section-{{ section.id }}-padding">
  <div class="wa-anatomy__container">
    
    <div class="wa-anatomy__header">
      <div class="wa-anatomy__badge">
        <span>✦</span> MASTER PERFUMER’S NOTE ARCHITECTURE
      </div>
      <h2 class="wa-anatomy__title">{{ section.settings.title | default: 'The 3 Evolution Phases of Pure Attar' }}</h2>
      <p class="wa-anatomy__subtitle">
        Unlike synthetic alcohol sprays that vanish in minutes, 100% pure attar oil bonds with your pulse points, revealing a magnificent three-stage aromatic journey throughout your day.
      </p>
    </div>

    <!-- Attar Switcher Tabs -->
    <div class="wa-anatomy__tabs" id="AnatomyTabs">
      <button class="wa-anatomy__tab-btn is-active" data-attar="turkish-oud">Turkish Oud</button>
      <button class="wa-anatomy__tab-btn" data-attar="bakhoor">Bakhoor</button>
      <button class="wa-anatomy__tab-btn" data-attar="salma">Salma</button>
      <button class="wa-anatomy__tab-btn" data-attar="musk-al-oudh">Musk Al Oudh</button>
    </div>

    <!-- Layout: Left Profile Card + Right Phase Breakdown -->
    <div class="wa-anatomy__layout">
      
      <!-- Left Panel -->
      <div class="wa-anatomy__profile-card">
        <div>
          <span class="wa-anatomy__profile-tag" id="ProfileTag">WARM WOODY & ROSE</span>
          <h3 class="wa-anatomy__profile-name" id="ProfileName">Turkish Oud Luxury Attar</h3>
          <p class="wa-anatomy__profile-vibe" id="ProfileVibe">
            An opulent union of Isparta Rose petals, warm glowing amber, and Cambodian agarwood crafted for memorable authority.
          </p>
        </div>

        <div class="wa-anatomy__metrics">
          <div class="wa-anatomy__metric">
            <div class="wa-anatomy__metric-header">
              <span class="wa-anatomy__metric-label">Longevity on Skin</span>
              <span class="wa-anatomy__metric-val" id="MetricLongevity">14+ Hours</span>
            </div>
            <div class="wa-anatomy__metric-bar">
              <div class="wa-anatomy__metric-fill" id="FillLongevity" style="width: 95%;"></div>
            </div>
          </div>

          <div class="wa-anatomy__metric">
            <div class="wa-anatomy__metric-header">
              <span class="wa-anatomy__metric-label">Sillage Aura</span>
              <span class="wa-anatomy__metric-val" id="MetricSillage">Room-Filling Presence</span>
            </div>
            <div class="wa-anatomy__metric-bar">
              <div class="wa-anatomy__metric-fill" id="FillSillage" style="width: 92%;"></div>
            </div>
          </div>

          <div class="wa-anatomy__metric">
            <div class="wa-anatomy__metric-header">
              <span class="wa-anatomy__metric-label">Concentration</span>
              <span class="wa-anatomy__metric-val">100% Pure Oil</span>
            </div>
            <div class="wa-anatomy__metric-bar">
              <div class="wa-anatomy__metric-fill" style="width: 100%;"></div>
            </div>
          </div>
        </div>

        <a href="/products/turkish-oud-luxury-attar" class="wa-anatomy__profile-cta" id="ProfileLink">
          Experience This Fragrance →
        </a>
      </div>

      <!-- Right 3-Phase Timeline -->
      <div class="wa-anatomy__phases">
        
        <!-- Phase 1: Top Notes -->
        <div class="wa-anatomy__phase-card">
          <div class="wa-anatomy__phase-badge-col">
            <span class="wa-anatomy__phase-num">PHASE 01</span>
            <h4 class="wa-anatomy__phase-title">Top Notes</h4>
            <span class="wa-anatomy__phase-time">First 0 – 30 Minutes</span>
          </div>
          <div class="wa-anatomy__phase-desc-col">
            <p class="wa-anatomy__phase-notes" id="NotesTop">Turkish Rose Petals, Sweet Cardamom, Pink Pepper</p>
            <p class="wa-anatomy__phase-story" id="StoryTop">
              The opening greeting. An effervescent, spicy-floral burst that captures immediate attention without harsh synthetic fumes.
            </p>
          </div>
        </div>

        <!-- Phase 2: Heart Notes -->
        <div class="wa-anatomy__phase-card">
          <div class="wa-anatomy__phase-badge-col">
            <span class="wa-anatomy__phase-num">PHASE 02</span>
            <h4 class="wa-anatomy__phase-title">Heart Notes</h4>
            <span class="wa-anatomy__phase-time">30 Mins – 6 Hours</span>
          </div>
          <div class="wa-anatomy__phase-desc-col">
            <p class="wa-anatomy__phase-notes" id="NotesHeart">Golden Amber Resin, Smoky Frankincense, Cedarwood</p>
            <p class="wa-anatomy__phase-story" id="StoryHeart">
              The signature body. As body warmth melts the oil, deep balsamic resins emerge into a warm, intoxicating velvet aura.
            </p>
          </div>
        </div>

        <!-- Phase 3: Base Notes -->
        <div class="wa-anatomy__phase-card">
          <div class="wa-anatomy__phase-badge-col">
            <span class="wa-anatomy__phase-num">PHASE 03</span>
            <h4 class="wa-anatomy__phase-title">Base Notes</h4>
            <span class="wa-anatomy__phase-time">6 – 16+ Hours</span>
          </div>
          <div class="wa-anatomy__phase-desc-col">
            <p class="wa-anatomy__phase-notes" id="NotesBase">Aged Cambodian Agarwood, Mysore Sandalwood, Velvet Musk</p>
            <p class="wa-anatomy__phase-story" id="StoryBase">
              The regal foundation. Heavy molecular resin bonds to skin lipids, leaving an intimate trail that endures through evening encounters.
            </p>
          </div>
        </div>

      </div>

    </div>

  </div>
</div>

<script>
  (function() {
    const data = {
      'turkish-oud': {
        tag: 'WARM WOODY & ROSE',
        name: 'Turkish Oud Luxury Attar',
        vibe: 'An opulent union of Isparta Rose petals, warm glowing amber, and Cambodian agarwood crafted for memorable authority.',
        link: '/products/turkish-oud-luxury-attar',
        longevity: '14+ Hours',
        longevityFill: '95%',
        sillage: 'Room-Filling Presence',
        sillageFill: '92%',
        topNotes: 'Turkish Rose Petals, Sweet Cardamom, Pink Pepper',
        topStory: 'The opening greeting. An effervescent, spicy-floral burst that captures immediate attention without harsh synthetic fumes.',
        heartNotes: 'Golden Amber Resin, Smoky Frankincense, Cedarwood',
        heartStory: 'The signature body. As body warmth melts the oil, deep balsamic resins emerge into a warm, intoxicating velvet aura.',
        baseNotes: 'Aged Cambodian Agarwood, Mysore Sandalwood, Velvet Musk',
        baseStory: 'The regal foundation. Heavy molecular resin bonds to skin lipids, leaving an intimate trail that endures through evening encounters.'
      },
      'bakhoor': {
        tag: 'SMOKY INCENSE & RESIN',
        name: 'Bakhoor Luxury Attar',
        vibe: 'Mystical Arabian evening incense and smoldering agarwood chips that evoke grand royal courtyards.',
        link: '/products/bakhoor-luxury-attar',
        longevity: '16+ Hours',
        longevityFill: '98%',
        sillage: 'Beast Mode Trail',
        sillageFill: '96%',
        topNotes: 'Frankincense Smoke, Crushed Peppercorns, Saffron Threads',
        topStory: 'A spiritual smoky-sweet aura that commands instant reverence upon entering any gathering.',
        heartNotes: 'Smoldering Agarwood, Labdanum Resin, Birchwood',
        heartStory: 'Deep balsamic resins that envelope you in a dignified shield of incense warmth.',
        baseNotes: 'Aged Assam Oud, Dark Benzoin, Golden Tobacco Accord',
        baseStory: 'Unshakable longevity that lingers past 24 hours on wool, cotton, and jacket collars.'
      },
      'salma': {
        tag: 'DEWY ROMANTIC FLORAL',
        name: 'Salma Royal Floral Attar',
        vibe: 'A romantic whisper of morning Kannauj blossoms, Sambac Mogra, and velvety cashmere musk.',
        link: '/products/salma-luxury-attar',
        longevity: '12+ Hours',
        longevityFill: '88%',
        sillage: 'Intimate Alluring Halo',
        sillageFill: '85%',
        topNotes: 'Morning Rose Water, Citrus Blossom, Sweet Lily',
        topStory: 'Crisp, dewy floral sweetness that feels fresh like garden rain at dawn.',
        heartNotes: 'Royal Sambac Mogra, French Jasmine, White Amber',
        heartStory: 'Intoxicating white flowers that effortlessly draw quiet compliments in close conversations.',
        baseNotes: 'Velvet Cashmere Musk, Soft Sandalwood, Bourbon Vanilla',
        baseStory: 'A creamy, soothing cocoon that softens into an irresistible second-skin signature.'
      },
      'musk-al-oudh': {
        tag: 'IMPERIAL DEPTH & PRESENCE',
        name: 'Musk Al Oudh Luxury Attar',
        vibe: 'Pristine Himalayan white musk crowned with the regal depth of vintage Assam agarwood.',
        link: '/products/musk-al-oudh-luxury-attar',
        longevity: '15+ Hours',
        longevityFill: '96%',
        sillage: 'Executive Boardroom Sillage',
        sillageFill: '94%',
        topNotes: 'Himalayan White Musk, Fresh Bergamot, Dry Cardamom',
        topStory: 'Pristine mountain coolness that projects sharp, poised executive authority.',
        heartNotes: 'Aged Assam Agarwood, Cedar Leaf, Warm Leather Accord',
        heartStory: 'Noble woods that establish steadfast confidence throughout boardroom marathons.',
        baseNotes: 'Mysore Sandalwood, Birch Wood, Earthy Patchouli',
        baseStory: 'A timeless aristocratic finish that refuses to fade until washed.'
      }
    };

    const tabsContainer = document.getElementById('AnatomyTabs');
    if (!tabsContainer) return;

    const btns = tabsContainer.querySelectorAll('.wa-anatomy__tab-btn');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-attar');
        const item = data[key];
        if (!item) return;

        btns.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        document.getElementById('ProfileTag').textContent = item.tag;
        document.getElementById('ProfileName').textContent = item.name;
        document.getElementById('ProfileVibe').textContent = item.vibe;
        document.getElementById('ProfileLink').setAttribute('href', item.link);
        
        document.getElementById('MetricLongevity').textContent = item.longevity;
        document.getElementById('FillLongevity').style.width = item.longevityFill;
        document.getElementById('MetricSillage').textContent = item.sillage;
        document.getElementById('FillSillage').style.width = item.sillageFill;

        document.getElementById('NotesTop').textContent = item.topNotes;
        document.getElementById('StoryTop').textContent = item.topStory;
        document.getElementById('NotesHeart').textContent = item.heartNotes;
        document.getElementById('StoryHeart').textContent = item.heartStory;
        document.getElementById('NotesBase').textContent = item.baseNotes;
        document.getElementById('StoryBase').textContent = item.baseStory;
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Scent Anatomy Visualizer",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "The 3 Evolution Phases of Pure Attar"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Scent Anatomy Visualizer"
    }
  ]
}
{% endschema %}
