{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 28 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 28 }}px;
  }

  .wa-usp-strip {
    background: #FFFFFF;
    border-top: 1px solid #EAE5DE;
    border-bottom: 1px solid #EAE5DE;
    position: relative;
    overflow: hidden;
  }

  .wa-usp-strip__container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  .wa-usp-strip__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  @media screen and (max-width: 989px) {
    .wa-usp-strip__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.2rem;
    }
  }

  @media screen and (max-width: 520px) {
    .wa-usp-strip__grid {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }

  .wa-usp-strip__item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    background: #FAF8F5;
    border: 1px solid #EFEAE2;
    border-radius: 8px;
    transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: relative;
  }

  .wa-usp-strip__item:hover {
    background: #FFFFFF;
    border-color: #B8974F;
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(184, 151, 79, 0.14);
  }

  .wa-usp-strip__number {
    font-family: var(--wa-font-heading, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.45rem;
    font-weight: 700;
    color: #B8974F;
    line-height: 1;
    opacity: 0.85;
    flex-shrink: 0;
    min-width: 24px;
  }

  .wa-usp-strip__icon-wrap {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    border: 1px solid #E5D7B5;
    border-radius: 6px;
    color: #917333;
    transition: transform 0.3s ease;
  }

  .wa-usp-strip__item:hover .wa-usp-strip__icon-wrap {
    transform: scale(1.1) rotate(4deg);
    background: #FAF6ED;
    color: #B8974F;
  }

  .wa-usp-strip__icon-wrap svg {
    width: 20px;
    height: 20px;
  }

  .wa-usp-strip__content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .wa-usp-strip__title {
    font-family: var(--wa-font-body, 'Montserrat', sans-serif);
    font-size: 0.88rem;
    font-weight: 700;
    color: #121212;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
    line-height: 1.35;
  }

  .wa-usp-strip__desc {
    font-family: var(--wa-font-body, 'Montserrat', sans-serif);
    font-size: 0.8rem;
    color: #666666;
    margin: 0;
    line-height: 1.45;
  }
{%- endstyle -%}

<div class="wa-usp-strip section-{{ section.id }}-padding">
  <div class="wa-usp-strip__container">
    <div class="wa-usp-strip__grid">
      {%- for block in section.blocks -%}
        <div class="wa-usp-strip__item" {{ block.shopify_attributes }}>
          <span class="wa-usp-strip__number">0{{ forloop.index }}</span>
          
          <div class="wa-usp-strip__icon-wrap">
            {%- case block.settings.icon -%}
              {%- when 'perfume' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M10 2h4M12 2v4M6 6h12v14a2 2 0 01-2 2H8a2 2 0 01-2-2V6z"/>
                  <circle cx="12" cy="13" r="2"/>
                </svg>
              {%- when 'stopwatch' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <circle cx="12" cy="13" r="8"/>
                  <path d="M12 9v4l2.5 2.5M12 2v3M10 2h4"/>
                </svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M11 20A7 7 0 014 13C4 7 11 3 20 4c1 9-3 16-9 16z"/>
                  <path d="M11 20v-7a4 4 0 014-4"/>
                </svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="1" y="4" width="15" height="13" rx="1"/>
                  <polygon points="16 8 20 8 23 11 23 17 16 17 16 8"/>
                  <circle cx="5.5" cy="18.5" r="2.5"/>
                  <circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
            {%- endcase -%}
          </div>

          <div class="wa-usp-strip__content">
            <h4 class="wa-usp-strip__title">{{ block.settings.title }}</h4>
            <p class="wa-usp-strip__desc">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Luxury Brand Trust Strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Trust Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "perfume", "label": "Perfume Flacon" },
            { "value": "stopwatch", "label": "Longevity Stopwatch" },
            { "value": "leaf", "label": "Natural Leaf" },
            { "value": "truck", "label": "Fast Delivery Truck" },
            { "value": "star", "label": "Gold Star" }
          ],
          "default": "perfume"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Pillar Title",
          "default": "100% Alcohol-Free"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short Explanation",
          "default": "Pure concentrated oil. Zero synthetic gas or dilution."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Brand Trust Strip",
      "blocks": [
        {
          "type": "usp",
          "settings": {
            "icon": "perfume",
            "title": "100% Alcohol-Free",
            "text": "Pure uncut attar oil. 0% synthetic gas or skin irritation."
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "stopwatch",
            "title": "14+ Hours Projection",
            "text": "High molecular weight density that bonds with skin warmth."
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "leaf",
            "title": "Ancient Kannauj Craft",
            "text": "Artisanal Deg-Bhapka wood-fired copper steam distillation."
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "truck",
            "title": "Free Cash On Delivery",
            "text": "Pan-India fast dispatch with 100% leak-proof packaging."
          }
        }
      ]
    }
  ]
}
{% endschema %}
