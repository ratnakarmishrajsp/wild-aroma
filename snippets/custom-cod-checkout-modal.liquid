{%- assign is_theme_preview_or_admin = false -%}
{%- if content_for_header contains 'adminBarInjector' or content_for_header contains 'preview_bar_injector' or request.design_mode -%}
  {%- assign is_theme_preview_or_admin = true -%}
{%- endif -%}

<script>
  (function() {
    const IS_ADMIN_VIEWER = {{ is_theme_preview_or_admin | json }};
    // Exact variant data from Shopify Liquid
    const rawVariants = {{ product.variants | json }};
    let currentMode = 'online'; // 'online' or 'cod'
    const DISCOUNT_AMOUNT = 100; // Extra Rs 100 Off on Prepaid

    function ensureModalInBody() {
      const modal = document.getElementById('WildAromaOrderModal');
      if (modal && modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }
    }

    function getActiveVariant() {
      const varInput = document.querySelector('.product-form input[name="id"], input[name="id"]:not([disabled]), select[name="id"]');
      const curId = varInput ? varInput.value : '';
      if (curId) {
        const found = rawVariants.find(v => String(v.id) === String(curId));
        if (found) return found;
      }
      return rawVariants[0];
    }

    function formatRupees(num) {
      return '₹' + Math.round(num).toLocaleString('en-IN');
    }

    function updateModalPricing() {
      const v = getActiveVariant();
      if (!v) return;

      const regularRupees = Math.round(v.price / 100);
      const compareRupees = v.compare_at_price ? Math.round(v.compare_at_price / 100) : (regularRupees * 2);
      const prepaidRupees = Math.max(0, regularRupees - DISCOUNT_AMOUNT);

      const titleEl = document.getElementById('smd-offer-title');
      const variantEl = document.getElementById('smd-offer-variant');
      const badgeEl = document.getElementById('smd-offer-badge');
      const displayPriceEl = document.getElementById('smd-display-price');
      const displayCutEl = document.getElementById('smd-display-cut');
      const headTitleEl = document.getElementById('smd-head-title');
      const headSubEl = document.getElementById('smd-head-subtitle');
      const headIconEl = document.getElementById('smd-head-icon');
      const headerBgEl = document.getElementById('smd-modal-header-bg');
      const btnTextEl = document.getElementById('smd-btn-text');
      const btnIconEl = document.getElementById('smd-btn-icon');
      const switchLinkEl = document.getElementById('smd-switch-link');

      // Update titles
      if (titleEl) titleEl.textContent = '{{ product.title | escape }}';
      if (variantEl) {
        variantEl.textContent = v.title && v.title !== 'Default Title' ? 'Size / Option: ' + v.title : 'Pure Attar Flacon (6 ML)';
      }

      if (currentMode === 'online') {
        // PREPAID MODE
        if (headerBgEl) headerBgEl.classList.remove('is-cod-mode');
        if (headIconEl) headIconEl.textContent = '⚡';
        if (headTitleEl) headTitleEl.textContent = 'Instant Prepaid Checkout';
        if (headSubEl) headSubEl.textContent = 'Pay with UPI, Google Pay, PhonePe, Cards or Net Banking';
        if (badgeEl) badgeEl.textContent = '🔥 SPECIAL PREPAID OFFER';
        if (displayPriceEl) displayPriceEl.textContent = formatRupees(prepaidRupees);
        if (displayCutEl) displayCutEl.textContent = formatRupees(compareRupees);
        if (btnIconEl) btnIconEl.textContent = '🔒';
        if (btnTextEl) btnTextEl.textContent = `PAY ${formatRupees(prepaidRupees)} WITH INSTANT UPI`;
        if (switchLinkEl) switchLinkEl.textContent = 'Prefer Cash on Delivery? Click here to switch';
      } else {
        // COD MODE
        if (headerBgEl) headerBgEl.classList.add('is-cod-mode');
        if (headIconEl) headIconEl.textContent = '📦';
        if (headTitleEl) headTitleEl.textContent = 'Cash on Delivery Checkout';
        if (headSubEl) headSubEl.textContent = 'Pay with cash at doorstep • Free Express Shipping';
        if (badgeEl) badgeEl.textContent = '📦 CASH ON DELIVERY AVAILABLE';
        if (displayPriceEl) displayPriceEl.textContent = formatRupees(regularRupees);
        if (displayCutEl) displayCutEl.textContent = formatRupees(compareRupees);
        if (btnIconEl) btnIconEl.textContent = '📦';
        if (btnTextEl) btnTextEl.textContent = `CONFIRM CASH ON DELIVERY (${formatRupees(regularRupees)})`;
        if (switchLinkEl) switchLinkEl.textContent = '⚡ Want Extra ₹100 OFF? Switch to Prepaid Payment';
      }

      // Also sync product page buttons pills
      const codPill = document.getElementById('wa-custom-cod-pill');
      const onlinePill = document.getElementById('wa-custom-online-pill');
      if (codPill) codPill.textContent = formatRupees(regularRupees);
      if (onlinePill) onlinePill.textContent = formatRupees(prepaidRupees);
    }

    window.openWildAromaOrderModal = function(preferredMode) {
      ensureModalInBody();
      currentMode = preferredMode === 'cod' ? 'cod' : 'online';
      updateModalPricing();

      const modal = document.getElementById('WildAromaOrderModal');
      if (!modal) return;

      modal.style.display = 'flex';
      document.body.classList.add('wa-modal-active');

      setTimeout(() => {
        modal.classList.add('is-open');
      }, 10);
    };

    window.closeWildAromaOrderModal = function() {
      const modal = document.getElementById('WildAromaOrderModal');
      if (!modal) return;

      modal.classList.remove('is-open');
      document.body.classList.remove('wa-modal-active');

      setTimeout(() => {
        modal.style.display = 'none';
      }, 250);
    };

    window.togglePaymentMode = function() {
      currentMode = currentMode === 'online' ? 'cod' : 'online';
      updateModalPricing();
    };

    // Close on backdrop click
    document.addEventListener('click', function(e) {
      const modal = document.getElementById('WildAromaOrderModal');
      if (modal && e.target === modal) {
        closeWildAromaOrderModal();
      }
    });

    // Close on Escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeWildAromaOrderModal();
    });

    // In-memory Pincode Cache for instantaneous autocomplete
    const pinCache = {};

    // Pincode auto-lookup
    const pinInput = document.getElementById('smd_input_pincode');
    const pinLoader = document.getElementById('smd-pin-loader');
    const pinBadge = document.getElementById('smd-pin-verified-badge');
    const cityInput = document.getElementById('smd_input_city');
    const stateInput = document.getElementById('smd_input_state');

    function applyPinData(city, state) {
      if (cityInput) cityInput.value = city;
      if (stateInput) stateInput.value = state;
      if (pinBadge) {
        pinBadge.textContent = `✓ Delivery verified for ${city}, ${state}`;
        pinBadge.style.display = 'block';
      }
    }

    if (pinInput) {
      pinInput.addEventListener('input', function() {
        const pin = this.value.replace(/\D/g, '').slice(0, 6);
        this.value = pin;

        if (pin.length === 6) {
          if (pinCache[pin]) {
            applyPinData(pinCache[pin].city, pinCache[pin].state);
            return;
          }
          if (pinLoader) pinLoader.style.display = 'inline';
          fetch('https://api.postalpincode.in/pincode/' + pin)
            .then(res => res.json())
            .then(data => {
              if (pinLoader) pinLoader.style.display = 'none';
              if (data && data[0] && data[0].Status === 'Success' && data[0].PostOffice && data[0].PostOffice.length > 0) {
                const po = data[0].PostOffice[0];
                const city = po.District || po.Block || po.Circle || '';
                const state = po.State || '';
                pinCache[pin] = { city, state };
                applyPinData(city, state);
              }
            })
            .catch(() => {
              if (pinLoader) pinLoader.style.display = 'none';
            });
        } else {
          if (pinBadge) pinBadge.style.display = 'none';
        }
      });
    }

    // ========================================================
    // DUPLICATE / 3RD-ORDER LIMIT GUARD (24 Hours per Phone Number)
    // 1st & 2nd Orders: Smooth Instant Custom Modal Placement
    // 3rd Order: Blocked with WhatsApp Concierge Support Card
    // ========================================================
    const WA_ORDERS_KEY = 'wa_user_orders_v2';
    let isWhitelistedTestingIP = false;

    // Detect if client is testing from IP 152.58.155.233 / 152.58.* or admin/tester
    (function initTestingIPCheck() {
      // 1. Immediate local / URL / Admin checks
      if (
        (typeof IS_ADMIN_VIEWER !== 'undefined' && IS_ADMIN_VIEWER) ||
        localStorage.getItem('wa_tester_mode') === 'true' ||
        window.location.search.includes('test') ||
        window.location.search.includes('reset') ||
        window.location.search.includes('preview') ||
        window.location.search.includes('admin')
      ) {
        isWhitelistedTestingIP = true;
        localStorage.setItem('wa_tester_mode', 'true');
        try { localStorage.removeItem(WA_ORDERS_KEY); } catch(e) {}
      }

      // 2. Query Server API for client IP whitelist
      const ORDER_API = '{{ settings.wa_order_api_url | default: "" }}' || window.WILD_AROMA_ORDER_API || 'https://crm.ratnakarmishra.in/wildaroma_order.php';
      fetch(ORDER_API + (ORDER_API.includes('?') ? '&' : '?') + 'action=check_client_ip')
        .then(res => res.json())
        .then(data => {
          if (data && (data.is_whitelisted || (data.ip && (data.ip.includes('152.58.') || data.ip.includes('152.58.155'))))) {
            isWhitelistedTestingIP = true;
            localStorage.setItem('wa_tester_mode', 'true');
            try { localStorage.removeItem(WA_ORDERS_KEY); } catch(e) {}
          }
        })
        .catch(() => {});

      // 3. Query ipify for IPv4 (matches 152.58.155.233 or 152.58.*)
      fetch('https://api.ipify.org?format=json')
        .then(res => res.json())
        .then(data => {
          if (data && (data.ip === '152.58.155.233' || (data.ip && data.ip.startsWith('152.58.')))) {
            isWhitelistedTestingIP = true;
            localStorage.setItem('wa_tester_mode', 'true');
            try { localStorage.removeItem(WA_ORDERS_KEY); } catch(e) {}
          }
        })
        .catch(() => {});
    })();

    function getTodayOrders(phoneClean) {
      if (
        isWhitelistedTestingIP ||
        (typeof IS_ADMIN_VIEWER !== 'undefined' && IS_ADMIN_VIEWER) ||
        localStorage.getItem('wa_tester_mode') === 'true' ||
        phoneClean === '9153334960' ||
        phoneClean === '9999999999'
      ) {
        return []; // NEVER block developer testing IP or admin!
      }
      try {
        const raw = localStorage.getItem(WA_ORDERS_KEY);
        if (!raw) return [];
        const list = JSON.parse(raw);
        const now = Date.now();
        const oneDayAgo = now - 24 * 60 * 60 * 1000;
        return list.filter(item => item.phone === phoneClean && item.time > oneDayAgo);
      } catch(e) {
        return [];
      }
    }

    function recordOrder(phoneClean, orderName) {
      if (
        isWhitelistedTestingIP ||
        (typeof IS_ADMIN_VIEWER !== 'undefined' && IS_ADMIN_VIEWER) ||
        localStorage.getItem('wa_tester_mode') === 'true' ||
        phoneClean === '9153334960' ||
        phoneClean === '9999999999'
      ) {
        return; // Don't persist locks for developer IP / admin
      }
      try {
        const raw = localStorage.getItem(WA_ORDERS_KEY);
        let list = raw ? JSON.parse(raw) : [];
        const now = Date.now();
        const oneDayAgo = now - 24 * 60 * 60 * 1000;
        list = list.filter(item => item.time > oneDayAgo);
        list.push({ phone: phoneClean, orderName: orderName || '', time: now });
        localStorage.setItem(WA_ORDERS_KEY, JSON.stringify(list));
      } catch(e) {}
    }

    // Live phone number monitor to trigger WhatsApp card if 3rd order
    const phoneInputEl = document.getElementById('smd_input_phone');
    if (phoneInputEl) {
      phoneInputEl.addEventListener('input', function() {
        let phone = this.value.replace(/\D/g, '').slice(0, 10);
        this.value = phone;

        const waBlockCard = document.getElementById('WildAromaWhatsAppBlockCard');
        const submitBtn = document.getElementById('WildAromaSubmitOrderBtn');

        if (phone.length === 10) {
          const pastOrders = getTodayOrders(phone);
          if (pastOrders.length >= 2) {
            // Block 3rd order immediately
            if (waBlockCard) waBlockCard.style.display = 'block';
            if (submitBtn) submitBtn.style.display = 'none';

            const waBtn = document.getElementById('smd-wa-block-btn');
            if (waBtn) {
              const prodTitle = encodeURIComponent('{{ product.title | escape }}');
              waBtn.href = `https://api.whatsapp.com/send?phone=919153334960&text=Hi%20Wild%20Aroma%2C%20I%20want%20to%20place%20an%20additional%20order%20for%20${prodTitle}.%20My%20Phone%3A%20${phone}`;
            }
          } else {
            if (waBlockCard) waBlockCard.style.display = 'none';
            if (submitBtn) submitBtn.style.display = 'flex';
          }
        } else {
          if (waBlockCard) waBlockCard.style.display = 'none';
          if (submitBtn) submitBtn.style.display = 'flex';
        }
      });
    }

    // Developer / testing helper to clear testing limits
    window.clearWildAromaTestLimits = function() {
      try {
        isWhitelistedTestingIP = true;
        localStorage.setItem('wa_tester_mode', 'true');
        localStorage.removeItem(WA_ORDERS_KEY);
        fetch('https://crm.ratnakarmishra.in/wildaroma_order.php?action=clear_rate_limits');
        const waBlockCard = document.getElementById('WildAromaWhatsAppBlockCard');
        if (waBlockCard) waBlockCard.style.display = 'none';
        const submitBtn = document.getElementById('WildAromaSubmitOrderBtn');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.style.display = 'flex';
        }
        alert('✅ Testing limits completely cleared!');
      } catch(e) {}
    };

    // Handle variant changes on product page
    document.addEventListener('change', function(e) {
      if (e.target && (e.target.name === 'id' || e.target.closest('variant-selects') || e.target.closest('.product-form__input'))) {
        setTimeout(updateModalPricing, 50);
      }
    });

    // Order Submit & Shopify Direct Placement
    window.submitWildAromaOrder = async function(e) {
      if (e && typeof e.preventDefault === 'function') {
        e.preventDefault();
        e.stopPropagation();
      }

      const nameInput = document.getElementById('smd_input_name');
      const phoneInput = document.getElementById('smd_input_phone');
      const addressInput = document.getElementById('smd_input_address');
      const landmarkInput = document.getElementById('smd_input_landmark');
      const pincodeInput = document.getElementById('smd_input_pincode');
      const cityInput = document.getElementById('smd_input_city');
      const stateInput = document.getElementById('smd_input_state');
      const statusBox = document.getElementById('WildAromaStatusBox');
      const submitBtn = document.getElementById('WildAromaSubmitOrderBtn');
      const btnText = document.getElementById('smd-btn-text');
      const waBlockCard = document.getElementById('WildAromaWhatsAppBlockCard');

      function showError(msg) {
        if (!statusBox) return;
        statusBox.textContent = msg;
        statusBox.className = 'smd-status-box error';
        statusBox.style.display = 'block';
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.style.display = 'flex';
        }
        if (btnText) {
          const v = getActiveVariant();
          const regularRupees = Math.round(v.price / 100);
          btnText.textContent = currentMode === 'online' ? `PAY ₹${Math.max(0, regularRupees - DISCOUNT_AMOUNT)} WITH INSTANT UPI` : `CONFIRM CASH ON DELIVERY (₹${regularRupees})`;
        }
      }

      const name = nameInput ? nameInput.value.trim() : '';
      let phone = phoneInput ? phoneInput.value.trim().replace(/\D/g, '') : '';
      if (phone.length === 12 && phone.startsWith('91')) phone = phone.slice(2);
      const address = addressInput ? addressInput.value.trim() : '';
      const landmark = landmarkInput ? landmarkInput.value.trim() : '';
      const pincode = pincodeInput ? pincodeInput.value.trim() : '';
      const city = cityInput ? cityInput.value.trim() : '';
      const state = stateInput ? stateInput.value.trim() : '';

      // Strict validation
      if (!name || name.length < 2) {
        showError('⚠️ Please enter your full name.');
        nameInput?.focus();
        return;
      }
      if (!phone || phone.length !== 10) {
        showError('⚠️ Please enter a valid 10-digit mobile number.');
        phoneInput?.focus();
        return;
      }
      if (!address || address.length < 5) {
        showError('⚠️ Please enter complete delivery address (House / Flat No., Street, Colony).');
        addressInput?.focus();
        return;
      }
      if (!pincode || pincode.length !== 6) {
        showError('⚠️ Please enter a valid 6-digit Pincode.');
        pincodeInput?.focus();
        return;
      }
      if (!city) {
        showError('⚠️ Please enter your City.');
        cityInput?.focus();
        return;
      }
      if (!state) {
        showError('⚠️ Please enter your State.');
        stateInput?.focus();
        return;
      }

      // ----------------------------------------------------
      // Multi-Order Protection Check
      // ----------------------------------------------------
      const pastOrders = getTodayOrders(phone);

      // Check 3rd Order: Blocked completely
      if (pastOrders.length >= 2) {
        if (waBlockCard) waBlockCard.style.display = 'block';
        if (submitBtn) submitBtn.style.display = 'none';
        if (statusBox) statusBox.style.display = 'none';

        const waBtn = document.getElementById('smd-wa-block-btn');
        if (waBtn) {
          const prodTitle = encodeURIComponent('{{ product.title | escape }}');
          waBtn.href = `https://api.whatsapp.com/send?phone=919153334960&text=Hi%20Wild%20Aroma%2C%20I%20want%20to%20place%20an%20additional%20order%20for%20${prodTitle}.%20My%20Phone%3A%20${phone}`;
        }
        return;
      }

      // Order API endpoint
      const THEME_ORDER_API = '{{ settings.wa_order_api_url | default: "" }}' || window.WILD_AROMA_ORDER_API || 'https://crm.ratnakarmishra.in/wildaroma_order.php';

      // UI state
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = '⏳ Creating Your Order...';
      if (statusBox) {
        statusBox.className = 'smd-status-box success';
        statusBox.textContent = '🚀 Placing your order... please wait a moment.';
        statusBox.style.display = 'block';
      }

      const activeVar = getActiveVariant();
      const variantId = activeVar ? activeVar.id : '{{ product.selected_or_first_available_variant.id }}';

      // ========================================================
      // 1. CASH ON DELIVERY VIA WORKER / SERVER API
      // ========================================================
      if (currentMode === 'cod' && THEME_ORDER_API) {
        try {
          const isTesterMode = isWhitelistedTestingIP || (typeof IS_ADMIN_VIEWER !== 'undefined' && IS_ADMIN_VIEWER) || localStorage.getItem('wa_tester_mode') === 'true';
          const res = await fetch(THEME_ORDER_API + (THEME_ORDER_API.includes('?') ? '&' : '?') + 'action=create_cod_order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name,
              phone,
              address,
              landmark,
              pincode,
              city,
              state,
              variant_id: variantId,
              quantity: 1,
              is_tester: isTesterMode
            })
          });

          const data = await res.json();

          // Server-side limit reached catch
          if (data && data.limit_reached) {
            if (waBlockCard) waBlockCard.style.display = 'block';
            if (submitBtn) submitBtn.style.display = 'none';
            if (statusBox) statusBox.style.display = 'none';
            const waBtn = document.getElementById('smd-wa-block-btn');
            if (waBtn && data.whatsapp_url) waBtn.href = data.whatsapp_url;
            return;
          }

          if (data && data.success && data.order_status_url) {
            // Record order in local cache
            recordOrder(phone, data.order_name);

            statusBox.className = 'smd-status-box success';
            statusBox.textContent = '🎉 Order #' + (data.order_name || '') + ' Confirmed! Redirecting to confirmation page...';

            // Clean form inputs so back button shows pristine state
            const form = document.getElementById('WildAromaOrderForm');
            if (form) form.reset();

            setTimeout(() => {
              window.location.href = data.order_status_url;
            }, 500);
            return;
          } else {
            throw new Error(data ? (data.error || 'Server returned failure') : 'Order API response missing');
          }
        } catch (apiErr) {
          console.warn('Direct COD API error:', apiErr);
          showError('⚠️ Direct order could not be placed: ' + apiErr.message);
          return;
        }
      }

      // ========================================================
      // 2. PREPAID ONLINE VIA PAYU (IF CONFIGURED)
      // ========================================================
      if (currentMode === 'online' && THEME_ORDER_API) {
        try {
          const regularPrice = Math.round((activeVar.price || 59900) / 100);
          const payAmount = Math.max(0, regularPrice - DISCOUNT_AMOUNT);

          const res = await fetch(THEME_ORDER_API + (THEME_ORDER_API.includes('?') ? '&' : '?') + 'action=payu_initiate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              amount: payAmount,
              product_name: '{{ product.title | escape }}',
              name,
              email: phone + '@wildaroma.in',
              phone
            })
          });

          const data = await res.json();
          if (data && data.success && data.hash && data.key && data.key !== 'YOUR_PAYU_MERCHANT_KEY') {
            const payuForm = document.createElement('form');
            payuForm.method = 'POST';
            payuForm.action = data.action_url;

            const fields = {
              key: data.key,
              txnid: data.txnid,
              amount: data.amount,
              productinfo: data.productinfo,
              firstname: data.firstname,
              email: data.email,
              phone: data.phone,
              surl: data.surl,
              furl: data.furl,
              hash: data.hash
            };

            for (const k in fields) {
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = k;
              input.value = fields[k];
              payuForm.appendChild(input);
            }

            document.body.appendChild(payuForm);
            payuForm.submit();
            return;
          }
        } catch (payuErr) {
          console.warn('PayU initiation error:', payuErr);
        }
      }

      // ========================================================
      // 3. SHOPIFY NATIVE CHECKOUT FALLBACK (PRE-FILLED)
      // ========================================================
      try {
        await fetch('/cart/clear.js', { method: 'POST' });
        const fullAddress = address + (landmark ? ' (Landmark: ' + landmark + ')' : '');
        const paymentChoice = currentMode === 'online' ? 'Prepaid Online (Extra ₹100 Off)' : 'Cash on Delivery (COD)';

        const addRes = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: variantId,
            quantity: 1,
            properties: {
              'Customer Name': name,
              'Mobile': phone,
              'Delivery Address': fullAddress,
              'City': city,
              'State': state,
              'Pincode': pincode,
              'Payment Mode': paymentChoice
            }
          })
        });

        if (!addRes.ok) {
          throw new Error('Failed to update cart. Please refresh and try again.');
        }

        const checkoutParams = new URLSearchParams();
        checkoutParams.append('checkout[email]', phone + '@wildaroma.in');
        checkoutParams.append('checkout[shipping_address][first_name]', name);
        checkoutParams.append('checkout[shipping_address][phone]', phone);
        checkoutParams.append('checkout[shipping_address][address1]', fullAddress);
        checkoutParams.append('checkout[shipping_address][city]', city);
        checkoutParams.append('checkout[shipping_address][province]', state);
        checkoutParams.append('checkout[shipping_address][zip]', pincode);
        checkoutParams.append('checkout[shipping_address][country]', 'India');

        if (currentMode === 'online') {
          checkoutParams.append('discount', 'WILD100');
        }

        window.location.href = '/checkout?' + checkoutParams.toString();
      } catch (err) {
        showError('⚠️ ' + (err.message || 'Unable to open checkout.'));
      }
    };

    // ========================================================
    // BROWSER BACK BUTTON (BFCACHE) DATA & MODAL SANITIZATION
    // Ensures stale customer data is completely cleared if the user
    // navigates back from the Thank You page.
    // ========================================================
    window.addEventListener('pageshow', function() {
      const form = document.getElementById('WildAromaOrderForm');
      if (form) form.reset();

      const modal = document.getElementById('WildAromaOrderModal');
      if (modal) {
        modal.classList.remove('is-open');
        modal.style.display = 'none';
      }
      document.body.classList.remove('wa-modal-active');

      const statusBox = document.getElementById('WildAromaStatusBox');
      if (statusBox) {
        statusBox.style.display = 'none';
        statusBox.textContent = '';
      }

      const waBlockCard = document.getElementById('WildAromaWhatsAppBlockCard');
      if (waBlockCard) waBlockCard.style.display = 'none';

      const submitBtn = document.getElementById('WildAromaSubmitOrderBtn');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.style.display = 'flex';
      }

      const pinBadge = document.getElementById('smd-pin-verified-badge');
      if (pinBadge) pinBadge.style.display = 'none';

      updateModalPricing();
    });

    // Initial pricing sync and DOM relocation
    document.addEventListener('DOMContentLoaded', function() {
      ensureModalInBody();
      updateModalPricing();
    });
    setTimeout(function() {
      ensureModalInBody();
      updateModalPricing();
    }, 200);
  })();
</script>
