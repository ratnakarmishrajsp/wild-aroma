{% comment %}
  Custom High-Converting Checkout Modal for Wild Aroma
  Pixel-perfect replica of the SMD / Releasit reference design, styled in Wild Aroma Luxury aesthetics.
{% endcomment %}

<div id="WildAromaOrderModal" class="smd-modal-overlay" style="display:none;" aria-hidden="true" role="dialog">
  <div class="smd-modal-card">
    <!-- Modal Header -->
    <div class="smd-modal-header" id="smd-modal-header-bg">
      <div class="smd-modal-header-left">
        <div class="smd-title-row">
          <span class="smd-lightning" id="smd-head-icon">⚡</span>
          <h3 class="smd-header-title" id="smd-head-title">Instant Prepaid Checkout</h3>
        </div>
        <p class="smd-header-subtitle" id="smd-head-subtitle">Pay with UPI, Google Pay, PhonePe, Cards or Net Banking</p>
      </div>
      <button type="button" class="smd-modal-close" onclick="closeWildAromaOrderModal()" aria-label="Close modal">&times;</button>
    </div>

    <!-- Modal Body -->
    <div class="smd-modal-body">
      <!-- Special Offer Summary Card -->
      <div class="smd-offer-card" id="smd-offer-card">
        <div class="smd-offer-left">
          <span class="smd-offer-tag" id="smd-offer-badge">🔥 SPECIAL PREPAID OFFER</span>
          <span class="smd-offer-title" id="smd-offer-title">{{ product.title | escape }}</span>
          <span class="smd-offer-variant" id="smd-offer-variant">
            {%- unless product.has_only_default_variant -%}
              Size: {{ product.selected_or_first_available_variant.title }}
            {%- else -%}
              Pure Attar Flacon (6 ML)
            {%- endunless -%}
          </span>
        </div>
        <div class="smd-offer-pricing">
          <span class="smd-price-bold" id="smd-display-price">₹549</span>
          <span class="smd-price-cut" id="smd-display-cut">₹1,299</span>
        </div>
      </div>

      <!-- Customer Address Form -->
      <form id="WildAromaOrderForm" class="smd-form" onsubmit="if(event)event.preventDefault(); submitWildAromaOrder(event); return false;" novalidate>
        <div class="smd-form-group">
          <label class="smd-label" for="smd_input_name">Full Name *</label>
          <input type="text" id="smd_input_name" class="smd-input" placeholder="Enter your full name" required autocomplete="name" />
        </div>

        <div class="smd-form-group">
          <label class="smd-label" for="smd_input_phone">Mobile Number (10 Digits) *</label>
          <input type="tel" id="smd_input_phone" class="smd-input" placeholder="e.g. 9876543210" maxlength="10" required autocomplete="tel" />
          <span class="smd-hint">We will send live tracking updates to this number on WhatsApp</span>
        </div>

        <div class="smd-form-group">
          <label class="smd-label" for="smd_input_address">Delivery Address (House / Flat No., Street, Colony) *</label>
          <input type="text" id="smd_input_address" class="smd-input" placeholder="House No., Building, Street Name, Area" required autocomplete="street-address" />
        </div>

        <div class="smd-form-group">
          <label class="smd-label" for="smd_input_landmark">Landmark (Optional)</label>
          <input type="text" id="smd_input_landmark" class="smd-input" placeholder="Nearby School, Hospital, Temple, or Shop" />
        </div>

        <div class="smd-row-2">
          <div class="smd-form-group">
            <label class="smd-label" for="smd_input_pincode">Pincode *</label>
            <div class="smd-pin-wrap">
              <input type="tel" id="smd_input_pincode" class="smd-input" placeholder="6-Digit PIN Code" maxlength="6" required autocomplete="postal-code" />
              <span id="smd-pin-loader" class="smd-pin-loader" style="display:none;">⏳</span>
            </div>
          </div>
          <div class="smd-form-group">
            <label class="smd-label" for="smd_input_city">City *</label>
            <input type="text" id="smd_input_city" class="smd-input" placeholder="City" required autocomplete="address-level2" />
          </div>
        </div>

        <div class="smd-form-group">
          <label class="smd-label" for="smd_input_state">State *</label>
          <input type="text" id="smd_input_state" class="smd-input" placeholder="State" required autocomplete="address-level1" />
        </div>

        <div id="smd-pin-verified-badge" class="smd-pin-verified" style="display:none;"></div>
        <div id="WildAromaStatusBox" class="smd-status-box" style="display:none;"></div>

        <!-- Daily Limit Reached (3rd Order Block) WhatsApp Card -->
        <div id="WildAromaWhatsAppBlockCard" class="smd-wa-block-card" style="display:none;">
          <div class="smd-wa-block-header">
            <span class="smd-wa-block-icon">🔒</span>
            <div>
              <h4 class="smd-wa-block-title">Daily COD Limit Reached (2 Orders Max)</h4>
              <p class="smd-wa-block-subtitle">To prevent duplicate bookings, maximum 2 COD orders per day are permitted online.</p>
            </div>
          </div>
          <p class="smd-wa-block-desc">
            Want to add more flacons or need custom assistance? Tap below to connect directly with our WhatsApp concierge:
          </p>
          <a id="smd-wa-block-btn" href="https://api.whatsapp.com/send?phone=919153334960" target="_blank" class="smd-wa-block-btn">
            <span>💬</span> Order via WhatsApp Support
          </a>
        </div>

        <!-- Submit Button -->
        <button type="button" id="WildAromaSubmitOrderBtn" class="smd-submit-btn" onclick="submitWildAromaOrder(event)">
          <span id="smd-btn-icon">🔒</span>
          <span id="smd-btn-text">PAY ₹549 WITH INSTANT UPI</span>
        </button>

        <!-- Toggle Payment Mode Link -->
        <div class="smd-mode-switch">
          <a href="javascript:void(0)" id="smd-switch-link" onclick="togglePaymentMode()">
            Prefer Cash on Delivery? Click here to switch
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="smd-trust-row">
          <span>🔒 100% Safe &amp; Verified</span>
          <span>•</span>
          <span>🚚 Free Express Delivery</span>
          <span>•</span>
          <span>💬 WhatsApp Support</span>
        </div>

        <div style="text-align: center; margin-top: 6px;">
          <a href="javascript:void(0)" onclick="clearWildAromaTestLimits()" style="font-size: 11px; color: #94a3b8; text-decoration: underline;">
            🛠️ Reset Test Limits (Developer IP Mode)
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
