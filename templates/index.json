    "custom_faq_homepage": {
      "type": "custom-faq",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "How should I apply concentrated attar oil?",
            "answer": "<p>Apply 2–3 drops to your key pulse points: inner wrists, base of the neck, behind the ears, and collarbones. Gently tap—never rub—to preserve the fragrance pyramid and let it develop naturally with your body heat.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Is it safe to apply attar on clothes?",
            "answer": "<p>Because Wild Aroma attars are 100% pure concentrated essential oils with zero synthetic solvents, we recommend applying directly onto warm pulse points. If applying on fabrics, dab lightly onto inner dark seams or jacket lapels.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "How long does Wild Aroma attar last?",
            "answer": "<p>Due to high natural oil concentration and ancient Kannauj Deg-Bhapka distillation, our attars typically project for 12 to 16+ hours on skin and well past 24 hours on fabrics. Oud, amber, and musk profiles exhibit exceptional longevity.</p>"
          }
        }
      },
